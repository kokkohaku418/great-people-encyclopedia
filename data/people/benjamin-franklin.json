  "overview": {
    "en": "Benjamin Franklin was an American polymath, statesman, and one of the Founding Fathers of the United States. As a scientist, he is best known for his experiments with electricity, including the famous kite experiment, and for inventing the lightning rod.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Franklin was born in 1706 in Boston, Massachusetts, the fifteenth of seventeen children. Largely self-educated after leaving school at age ten, he became a successful printer in Philadelphia and used his wealth to pursue scientific and civic interests.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Franklin's experiments proved that lightning is electrical in nature and led to the invention of the lightning rod, saving countless buildings from fire. His concepts of positive and negative electrical charge remain fundamental to the understanding of electricity.",
