  "overview": {
    "en": "Sin-Itiro Tomonaga was a Japanese theoretical physicist who shared the 1965 Nobel Prize in Physics for his independent development of quantum electrodynamics. Working largely in isolation in wartime Japan, he developed a relativistically covariant formulation of QED.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Tomonaga was born in Tokyo and grew up in Kyoto, where his father was a professor of philosophy. He studied at Kyoto Imperial University alongside Hideki Yukawa and later worked with Werner Heisenberg in Leipzig.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Tomonaga's renormalization technique in quantum electrodynamics, developed independently of Schwinger and Feynman, was crucial for making QED a consistent and predictive theory. He also mentored a generation of Japanese theoretical physicists.",
