  "early_life": {
    "en": "Weinberg was born in New York City and attended the Bronx High School of Science alongside Sheldon Glashow. He earned his Ph.D. from Princeton University and held positions at Berkeley, MIT, Harvard, and the University of Texas at Austin.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Weinberg's electroweak unification became a cornerstone of the Standard Model of particle physics. His textbooks on quantum field theory and cosmology became standard references, and he was a prominent public voice for science, writing extensively for general audiences.",
