  "overview": {
    "en": "Augustin-Jean Fresnel was a French civil engineer and physicist who made major contributions to the wave theory of light. He developed the mathematical framework for diffraction and polarization, and invented the Fresnel lens used in lighthouses worldwide.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Fresnel was born in 1788 in Broglie, Normandy, France. A slow learner as a child who could barely read at age eight, he later excelled in mathematics and attended the Ecole Polytechnique and the Ecole des Ponts et Chaussees to become a civil engineer.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Fresnel's wave theory of light, complete with a rigorous mathematical treatment of diffraction, definitively defeated Newton's corpuscular theory. His Fresnel lens revolutionized lighthouse technology and his equations for reflection and refraction remain fundamental in optics.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
