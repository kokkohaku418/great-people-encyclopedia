    "ja": ""
  },
  "early_life": {
    "en": "Archimedes was born around 287 BC in Syracuse, a Greek colony on the island of Sicily. He likely studied in Alexandria, Egypt, at the great library, before returning to Syracuse where he spent most of his life in the service of King Hiero II.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Archimedes laid the foundations of hydrostatics and statics, discovering the principle of buoyancy and the law of the lever. His mathematical methods anticipated integral calculus by nearly two millennia, and his war machines defended Syracuse against Roman siege.",
