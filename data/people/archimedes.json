  "overview": {
    "en": "Archimedes of Syracuse was an ancient Greek mathematician, physicist, engineer, and astronomer, widely regarded as one of the greatest scientists of antiquity. He made groundbreaking contributions to geometry, statics, hydrostatics, and the design of innovative machines.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
