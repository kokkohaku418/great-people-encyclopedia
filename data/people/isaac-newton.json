  "early_life": {
    "en": "Newton was born in 1643 in Woolsthorpe, Lincolnshire, England, a premature infant not expected to survive. Raised largely by his grandmother after his mother remarried, he attended the King's School in Grantham before enrolling at Trinity College, Cambridge, in 1661.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
