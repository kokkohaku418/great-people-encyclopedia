  "overview": {
    "en": "Kip Thorne is an American theoretical physicist who made pioneering contributions to gravitational physics and astrophysics. He shared the 2017 Nobel Prize in Physics for the first direct detection of gravitational waves by the LIGO experiment, which he co-founded.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
