  "overview": {
    "en": "Paul Dirac was an English theoretical physicist who made fundamental contributions to quantum mechanics and quantum electrodynamics. He predicted the existence of antimatter through the Dirac equation. He shared the 1933 Nobel Prize in Physics with Erwin Schrödinger.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Dirac was born in Bristol, England, to a Swiss father and English mother. He studied electrical engineering at the University of Bristol before switching to mathematics at the University of Cambridge, where he completed his PhD in 1926.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "The Dirac equation unified quantum mechanics and special relativity, predicting the existence of antimatter before its experimental discovery. His formulation of quantum mechanics using bra-ket notation became standard in physics. He is widely regarded as one of the greatest theoretical physicists of the 20th century.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
