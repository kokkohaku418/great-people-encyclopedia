  "overview": {
    "en": "Ibn al-Haytham, known in the West as Alhazen, was an Arab mathematician, astronomer, and physicist who is widely considered the father of modern optics. His Book of Optics fundamentally changed the understanding of light and vision.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Ibn al-Haytham was born in Basra, in present-day Iraq, around 965 AD. He received a thorough education in science and theology before moving to Cairo, Egypt, where he spent most of his productive years under the patronage of the Fatimid Caliphate.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Ibn al-Haytham's experimental method and insistence on empirical evidence anticipated the modern scientific method by centuries. His work on optics influenced European scientists including Roger Bacon, Kepler, and Descartes, and his camera obscura experiments laid groundwork for the development of photography.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
