  "overview": {
    "en": "Pyotr Kapitsa was a Soviet physicist who won the 1978 Nobel Prize in Physics for his fundamental discoveries in low-temperature physics. He discovered the superfluidity of liquid helium and made pioneering contributions to high-magnetic-field research.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Kapitsa was born in Kronstadt, Russia, and studied at the Petrograd Polytechnic Institute. He worked in Ernest Rutherford's Cavendish Laboratory at Cambridge from 1921 to 1934, before being detained in the Soviet Union during a visit.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Kapitsa's discovery of superfluidity opened a major new field in condensed matter physics. He also founded the Institute for Physical Problems in Moscow, which became one of the leading physics research centers in the world.",
