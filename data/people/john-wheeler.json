  "overview": {
    "en": "John Archibald Wheeler was an American theoretical physicist who made major contributions to general relativity and quantum gravity. He coined the terms 'black hole,' 'wormhole,' and 'quantum foam,' and mentored many of the most influential physicists of the 20th century.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "early_life": {
    "en": "Wheeler was born in Jacksonville, Florida, and earned his PhD from Johns Hopkins University at age 21. He studied with Niels Bohr in Copenhagen and collaborated with Bohr on the liquid drop model of nuclear fission.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
    "hi": "",
    "ar": "",
    "id": "",
    "ja": ""
  },
  "impact": {
    "en": "Wheeler revitalized the study of general relativity in the United States and trained a generation of leading physicists including Richard Feynman, Kip Thorne, and Hugh Everett. His conceptual insights into the nature of spacetime and quantum mechanics continue to inspire foundational physics research.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
    "zh": "",
