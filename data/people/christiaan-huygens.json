  "early_life": {
    "en": "Huygens was born in 1629 in The Hague, Netherlands, into a prominent diplomatic family. His father's connections with leading intellectuals, including Rene Descartes, provided young Christiaan with an exceptional education in mathematics and natural philosophy.",
    "es": "",
    "pt": "",
    "fr": "",
    "de": "",
